{
  "expo": {
    "name": "Daily Planner",
    "slug": "daily-planner",
    "version": "1.0.0",
    "scheme": "daily-planner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyplanner.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1117"
      },
      "package": "com.dailyplanner.app",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3b82f6",
          "iosDisplayInForeground": true,
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new interactions",
          "requestPermissions": true,
          "requestPermissionsText": "Daily Planner would like to send you notifications to remind you of upcoming tasks.",
          "infoPlist": {
            "NSUserNotificationUsageDescription": "Daily Planner uses notifications to remind you of upcoming tasks and Pomodoro timer intervals."
          },
          "sounds": []
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
